<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" 
    android:background="#121212" 
    android:padding="32dp">

    <TextView android:id="@+id/tvOverlayTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/overlay_title" android:textColor="#FFFFFF" android:textSize="32sp" android:textStyle="bold" 
        android:letterSpacing="0.05" android:layout_marginBottom="24dp" android:textAlignment="center"/>

    <TextView android:id="@+id/tvOverlayMessage" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="System Shield Active." android:textColor="#B0B0B0" android:textSize="18sp" 
        android:textAlignment="center" android:layout_marginBottom="48dp" android:lineSpacingExtra="4dp"/>

    <!-- The Tactical Desktop-Style Buttons -->
    <Button android:id="@+id/btnPauseBlocker" android:layout_width="match_parent" android:layout_height="65dp"
        android:text="DEFEND / OVERCOME" android:backgroundTint="#242424" android:textColor="#FFFFFF" 
        android:textSize="16sp" android:textStyle="bold" android:letterSpacing="0.05" android:layout_marginBottom="16dp" 
        style="?android:attr/borderlessButtonStyle"/>

    <Button android:id="@+id/btnYield" android:layout_width="match_parent" android:layout_height="65dp"
        android:text="I YIELD (RETURN HOME)" android:backgroundTint="#D32F2F" android:textColor="#FFFFFF" 
        android:textSize="16sp" android:textStyle="bold" android:letterSpacing="0.05" 
        style="?android:attr/borderlessButtonStyle"/>
        
    <TextView android:id="@+id/tvDebugReason" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Debug Reason: Unknown" android:textColor="#555555" android:textSize="12sp" 
        android:layout_marginTop="48dp" android:textAlignment="center" android:fontFamily="monospace"/>
</LinearLayout>