<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#121212" android:fillViewport="true">
    <LinearLayout android:id="@+id/llMainContent" android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:layout_marginBottom="16dp">
            <TextView android:id="@+id/tvShieldStatusIcon" android:layout_width="40dp" android:layout_height="40dp" android:text="🛡️" android:textSize="20sp" android:gravity="center" android:layout_alignParentStart="true" android:layout_centerVertical="true"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:layout_centerInParent="true"/>
            <Button android:id="@+id/btnSettings" android:layout_width="40dp" android:layout_height="40dp" android:text="⚙️" android:textSize="18sp" android:backgroundTint="#222" android:textColor="#FFF" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
        </RelativeLayout>

        

        <include layout="@layout/card_onboarding"/>

        <Button android:id="@+id/btnSafeAppManager" android:layout_width="match_parent" android:layout_height="60dp" android:text="SAFE APP MANAGER (UNINSTALL APPS)" android:background="@drawable/bg_btn_accent" android:textColor="#FFFFFF" android:visibility="gone" android:layout_marginBottom="16dp"/>

        <LinearLayout android:id="@+id/llMomentumContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MOMENTUM CORE" android:textAlignment="center" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
            <ProgressBar android:id="@+id/barMomentum" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" />
            <TextView android:id="@+id/tvMomentumText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 MINS AVAILABLE" android:textAlignment="center" android:textColor="#4CAF50" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Use them before they evaporate." android:textAlignment="center" android:textColor="#888888" android:textSize="12sp" android:layout_marginBottom="16dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnTabEarned" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:background="@drawable/bg_btn_accent" android:text="GAINED" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnTabSpent" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:background="@drawable/bg_btn_standard" android:text="SPEND" android:textColor="#FFFFFF" />
                <Button android:id="@+id/btnTabLeaders" android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:background="@drawable/bg_btn_standard" android:text="LEADERS" android:textColor="#FFFFFF" />
            </LinearLayout>

            <LinearLayout android:id="@+id/llEarnedList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp"/>
            <LinearLayout android:id="@+id/llSpentList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/llLeaderList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:visibility="gone"/>
        </LinearLayout>

        

        <LinearLayout android:id="@+id/llSafariCard" style="@style/AppCard">
            <Button android:id="@+id/btnGame" style="@style/AppButton.Accent" android:backgroundTint="#FF9800" android:text="OPEN NETBEAST SAFARI" android:layout_marginBottom="0dp"/>
        </LinearLayout>

        <include layout="@layout/card_overcome"/>

        <!-- HABIT SUBSTITUTION (REDIRECT) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HABIT SUBSTITUTION" android:textAlignment="center" android:textColor="#4CAF50" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Redirect bad habits instantly into productive ones." android:textAlignment="center" android:textColor="#888" android:textSize="12sp" android:layout_marginBottom="16dp"/>
            
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="When I try to access:" android:textColor="#FFF" android:textSize="14sp" />
            <Spinner android:id="@+id/spinRedirectTrigger" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="#4CAF50" android:layout_marginBottom="12dp"/>
            
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Channel energy to:" android:textColor="#FFF" android:textSize="14sp" />
            <Spinner android:id="@+id/spinRedirectTarget" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="#4CAF50" android:layout_marginBottom="8dp"/>
            
            <EditText android:id="@+id/etCustomRedirect" android:layout_width="match_parent" android:layout_height="48dp" android:hint="Enter custom URL (e.g. en.wikipedia.org)" android:textColorHint="#666" android:textColor="#FFF" android:backgroundTint="#FFF" android:singleLine="true" android:visibility="gone" android:layout_marginBottom="8dp"/>
            <Spinner android:id="@+id/spinCustomApp" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="#4CAF50" android:visibility="gone" android:layout_marginBottom="8dp"/>
            
            <Button android:id="@+id/btnAddRedirect" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_btn_success" android:text="ADD REDIRECT" android:textColor="#FFFFFF" />
            
            <LinearLayout android:id="@+id/llRedirects" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp"/>
        </LinearLayout>

        <!-- NIGHTFALL SHIELD -->
        <LinearLayout android:id="@+id/llNightfallCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp">
            
            
            <CheckBox android:id="@+id/cbMainNightfall" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enable Nightfall Mode (Calls Only)" android:textColor="#FFF" android:textSize="14sp" android:layout_marginBottom="12dp"/>
            <CheckBox android:id="@+id/cbNightfallNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Allow writing notes at night" android:textColor="#FFF" android:textSize="14sp" android:layout_marginBottom="12dp" android:checked="true"/>
            <LinearLayout android:id="@+id/llMainNightfallTimes" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:layout_marginBottom="8dp">
                <Button android:id="@+id/btnMainNightfallStart" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/bg_btn_standard" android:text="Start: Not Set" android:textColor="#FFFFFF" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnMainNightfallEnd" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/bg_btn_standard" android:text="End: Not Set" android:textColor="#FFFFFF" android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- DRASTIC OVERCOMING -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="24dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DRASTIC OVERCOMING" android:textAlignment="center" android:textColor="#F44336" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="These nuclear options can be engaged instantly, but can ONLY be disabled by scheduling a System Override Pause below." android:textAlignment="center" android:textColor="#888888" android:textSize="12sp" android:layout_marginBottom="16dp"/>
            
            <Button android:id="@+id/btnDrasticDumbPhoneCamera" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_btn_warning" android:text="Dumb Phone (WITH Camera)" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnDrasticDumbPhoneNoCamera" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_btn_warning" android:text="Dumb Phone (NO Camera)" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            
            <Button android:id="@+id/btnDrasticNoInternet" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_btn_warning" android:text="Remove Internet From My Phone" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnDrasticNoVideos" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_btn_warning" android:text="Block All Videos System-Wide" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnDrasticCallsOnly" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_btn_danger" android:text="Calls and Texts ONLY" android:textColor="#FFFFFF"/>
        </LinearLayout>

        
        <!-- SCREEN TINT & FOCUS -->
        <LinearLayout android:id="@+id/llTintCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="16dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SCREEN TINT &amp; FOCUS" android:textAlignment="center" android:textColor="#4CAF50" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Apply custom color filters to your entire phone, or make this app grayscale to reduce dopamine hits." android:textAlignment="center" android:textColor="#888" android:textSize="12sp" android:layout_marginBottom="16dp"/>
            
            <Button android:id="@+id/btnCustomTint" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_btn_standard" android:text="Set Custom Screen Tint (RGB)" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnToggleGrayscale" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_btn_standard" android:text="In-App Grayscale: OFF" android:textColor="#FFFFFF" android:layout_marginBottom="8dp"/>
            <Button android:id="@+id/btnLockTint" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_btn_standard" android:text="Lock Tint Settings" android:textColor="#FFFFFF"/>
        </LinearLayout>
        

        <!-- LIVE DEBUG TERMINAL -->
        <LinearLayout android:id="@+id/llDebugTerminal" android:layout_width="match_parent" android:layout_height="250dp" android:orientation="vertical" android:visibility="gone" android:background="#000000" android:padding="8dp" android:layout_marginTop="24dp" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="LIVE UI DEBUGGER ACTIVE" android:textColor="#00FF00" android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="4dp"/>
            <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
                <TextView android:id="@+id/tvTerminalOutput" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#00FF00" android:textSize="10sp" android:fontFamily="monospace"/>
            </ScrollView>
        </LinearLayout>
        
        <!-- SYSTEM OVERRIDE -->
        <Button android:id="@+id/btnToggleOverride" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="24dp" android:background="@drawable/bg_btn_standard" android:text="SYSTEM OVERRIDE (UNINSTALL/PAUSE)" android:textColor="#FFFFFF" />
        <LinearLayout android:id="@+id/llOverrideDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginTop="8dp" android:layout_marginBottom="40dp">
            <TextView android:id="@+id/tvOverrideStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select delay before unlock:" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginBottom="12dp"/>
            <SeekBar android:id="@+id/seekOverride" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="4" android:progress="0" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1D" android:textColor="#888" android:textSize="11sp" android:gravity="start"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="3D" android:textColor="#888" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="5D" android:textColor="#888" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1W" android:textColor="#888" android:textSize="11sp" android:gravity="center"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2W" android:textColor="#888" android:textSize="11sp" android:gravity="end"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Note: You can only increase this delay, never decrease it." android:textColor="#F44336" android:textSize="12sp" android:layout_marginTop="8dp" android:layout_marginBottom="16dp" android:textStyle="italic"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/btnSchedPause" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/bg_btn_warning" android:text="SCHED PAUSE" android:textColor="#FFFFFF" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnSchedUninstall" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:background="@drawable/bg_btn_danger" android:text="SCHED UNINSTALL" android:textColor="#FFFFFF" android:layout_marginStart="4dp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
