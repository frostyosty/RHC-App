<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

    <!-- APPS CARD (Moved to top) -->
    <LinearLayout android:id="@+id/cardOvercomeApp" style="@style/AppCard" android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="8dp" android:text="OVERCOME APPS" />
        <Spinner android:id="@+id/spinApps" android:layout_width="match_parent" android:layout_height="50dp" android:backgroundTint="#FFFFFF" />
        <Button android:id="@+id/btnAddApp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_btn_danger" android:textColor="#FFFFFF" android:text="OVERCOME SELECTED APP" android:layout_marginTop="8dp"/>
        <LinearLayout android:id="@+id/llBannedApps" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- WEB CARD (Moved to bottom) -->
    <LinearLayout android:id="@+id/cardOvercomeWeb" style="@style/AppCard" android:visibility="gone" android:layout_marginTop="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="8dp" android:text="OVERCOME WEBSITES" />
        <EditText android:id="@+id/etCustomWeb" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="e.g. reddit.com" android:textColor="#FFFFFF" android:textColorHint="#888" android:inputType="textUri"/>
        <Button android:id="@+id/btnAddWeb" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_btn_danger" android:textColor="#FFFFFF" android:text="OVERCOME WEBSITE" android:layout_marginTop="8dp"/>
        <LinearLayout android:id="@+id/llBannedWebs" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp"/>
    </LinearLayout>

</LinearLayout>
