# Build artifacts (regenerated by build scripts)
*.apk
*.exe
*.zip
*.o
*.res

# Android build output & local Gradle state (every module, incl. world-core
# and the root project's Kotlin/JS output)
**/build/
**/.gradle/
local.properties

# Signing keys
*.jks

# Node (used by tools/icons)
node_modules/

# clang-tidy compile database (generated by bear)
compile_commands.json

# Python bytecode (tools/sprite_studio/autogen)
__pycache__/

# 3D world preview renders (tools/world_preview/run.sh)
tools/world_preview/out/
