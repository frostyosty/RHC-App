{
  "permissions": {
    "deny": [
      "Read(**/node_modules/**)",
      "Read(**/target/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/.next/**)",
      "Read(**/coverage/**)",
      "Read(**/.venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/*.min.js)",
      "Read(**/*.min.css)",
      "Read(**/*.map)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/pnpm-lock.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/lcode/lean_bash.sh\""
          }
        ]
      }
    ]
  }
}
